{
  "name": "msme-copilot-api",
  "version": "1.0.0",
  "description": "Backend API for MSME AI Copilot",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seedData.js",
    "test": "npm run test:all",
    "test:all": "npm run test:orchestrator && npm run test:inventory && npm run test:finance && npm run test:sales && npm run test:gst && npm run test:support",
    "test:orchestrator": "node agents/orchestrator.test.js",
    "test:inventory": "node agents/inventoryAgent.test.js",
    "test:finance": "node agents/financeAgent.test.js",
    "test:sales": "node agents/salesAgent.test.js",
    "test:gst": "node agents/gstAgent.test.js",
    "test:support": "node agents/supportAgent.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "openai": "^3.3.0",
    "pdfkit": "^0.13.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
